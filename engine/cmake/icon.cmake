function(wp_icon_number OUT HEX OFFSET BYTES)
    set(VALUE 0)
    math(EXPR LAST "${BYTES} - 1")
    foreach(INDEX RANGE ${LAST} 0 -1)
        math(EXPR AT "(${OFFSET} + ${INDEX}) * 2")
        string(SUBSTRING "${HEX}" ${AT} 2 BYTE)
        math(EXPR VALUE "${VALUE} * 256 + 0x${BYTE}")
    endforeach()
    set(${OUT} ${VALUE} PARENT_SCOPE)
endfunction()

function(wp_icon_resource TARGET ICON)
    file(READ "${ICON}" HEADER LIMIT 6 HEX)
    wp_icon_number(COUNT "${HEADER}" 4 2)
    math(EXPR DIRECTORY_BYTES "6 + 16 * ${COUNT}")
    file(READ "${ICON}" HEX LIMIT ${DIRECTORY_BYTES} HEX)
    math(EXPR LAST "${COUNT} - 1")
    set(LINES ".section .rsrc,\\\"dr\\\"" ".balign 4" "wp_rsrc:"
        ".long 0, 0" ".word 0, 0, 0, 2"
        ".long 3, wp_rsrc_icons - wp_rsrc + 0x80000000"
        ".long 14, wp_rsrc_groups - wp_rsrc + 0x80000000"
        "wp_rsrc_icons:" ".long 0, 0" ".word 0, 0, 0, ${COUNT}")
    foreach(INDEX RANGE 0 ${LAST})
        math(EXPR ID "${INDEX} + 1")
        list(APPEND LINES ".long ${ID}, wp_rsrc_icon_${ID} - wp_rsrc + 0x80000000")
    endforeach()
    list(APPEND LINES "wp_rsrc_groups:" ".long 0, 0" ".word 0, 0, 0, 1" ".long 1, wp_rsrc_group - wp_rsrc + 0x80000000")
    foreach(INDEX RANGE 0 ${LAST})
        math(EXPR ID "${INDEX} + 1")
        list(APPEND LINES "wp_rsrc_icon_${ID}:" ".long 0, 0" ".word 0, 0, 0, 1" ".long 1033, wp_rsrc_icon_entry_${ID} - wp_rsrc")
    endforeach()
    list(APPEND LINES "wp_rsrc_group:" ".long 0, 0" ".word 0, 0, 0, 1" ".long 1033, wp_rsrc_group_entry - wp_rsrc")
    foreach(INDEX RANGE 0 ${LAST})
        math(EXPR ID "${INDEX} + 1")
        math(EXPR ENTRY "6 + 16 * ${INDEX}")
        math(EXPR SIZE_AT "${ENTRY} + 8")
        wp_icon_number(SIZE "${HEX}" ${SIZE_AT} 4)
        list(APPEND LINES "wp_rsrc_icon_entry_${ID}:" ".rva wp_rsrc_icon_data_${ID}" ".long ${SIZE}, 0, 0")
    endforeach()
    math(EXPR GROUP_BYTES "6 + 14 * ${COUNT}")
    list(APPEND LINES "wp_rsrc_group_entry:" ".rva wp_rsrc_group_data" ".long ${GROUP_BYTES}, 0, 0")
    list(APPEND LINES "wp_rsrc_group_data:" ".word 0, 1, ${COUNT}")
    foreach(INDEX RANGE 0 ${LAST})
        math(EXPR ID "${INDEX} + 1")
        math(EXPR ENTRY "6 + 16 * ${INDEX}")
        list(APPEND LINES ".incbin \\\"${ICON}\\\", ${ENTRY}, 12" ".word ${ID}")
    endforeach()
    foreach(INDEX RANGE 0 ${LAST})
        math(EXPR ID "${INDEX} + 1")
        math(EXPR ENTRY "6 + 16 * ${INDEX}")
        math(EXPR SIZE_AT "${ENTRY} + 8")
        math(EXPR START_AT "${ENTRY} + 12")
        wp_icon_number(SIZE "${HEX}" ${SIZE_AT} 4)
        wp_icon_number(START "${HEX}" ${START_AT} 4)
        list(APPEND LINES ".balign 4" "wp_rsrc_icon_data_${ID}:" ".incbin \\\"${ICON}\\\", ${START}, ${SIZE}")
    endforeach()
    list(APPEND LINES ".balign 4" ".text")
    set(SOURCE "asm(\n")
    foreach(LINE IN LISTS LINES)
        string(APPEND SOURCE "    \"${LINE}\\n\"\n")
    endforeach()
    string(APPEND SOURCE ");\n")
    set(OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/${TARGET}_icon.cpp")
    file(WRITE "${OUTPUT}.in" "${SOURCE}")
    configure_file("${OUTPUT}.in" "${OUTPUT}" COPYONLY)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ICON}")
    target_sources(${TARGET} PRIVATE "${OUTPUT}")
    set_source_files_properties("${OUTPUT}" PROPERTIES OBJECT_DEPENDS "${ICON}")
endfunction()
