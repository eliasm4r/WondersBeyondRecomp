{
  "name": "wondersbeyond-rooms",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "ratelimits": [
    {
      "name": "CREATE_LIMIT",
      "namespace_id": "1003",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "REQUEST_LIMIT",
      "namespace_id": "1004",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
}
