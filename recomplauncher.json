    {
      "id": "brightness", "label": "Brightness",
      "help": "Makes the whole picture lighter or darker. 100% is the original picture.",
      "slider": { "key": "video/brightness", "min": 50, "max": 150, "step": 5, "format": "%d" },
      "defaults": { "video/brightness": "100" }
